{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Sid": "ManageExistingRuntimeTags",
      "Resource": "arn:aws:bedrock-agentcore:eu-central-1:054776129200:runtime/AWSStudyCoach_default_agent-ftNEInBBU3",
      "Action": [
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:UntagResource",
        "bedrock-agentcore:UpdateAgentRuntime",
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:DeleteAgentRuntime"
      ]
    },
    {
      "Effect": "Allow",
      "Sid": "ReadAndTagExecutionRole",
      "Resource": "arn:aws:iam::054776129200:role/AgentCore-AWSStudyCoach-d-ApplicationRuntimeAgentRu-Jax59ePNLG2G",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ]
    },
    {
      "Effect": "Allow",
      "Sid": "PassExistingRoleToAgentCore",
      "Resource": "arn:aws:iam::054776129200:role/AgentCore-AWSStudyCoach-d-ApplicationRuntimeAgentRu-Jax59ePNLG2G",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      },
      "Action": "iam:PassRole"
    },
    {
      "Effect": "Allow",
      "Sid": "ManageStudyCoachRuntimeInlinePolicy",
      "Resource": "arn:aws:iam::054776129200:role/AgentCore-AWSStudyCoach-d-ApplicationRuntimeAgentRu-Jax59ePNLG2G",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ]
    },
    {
      "Effect": "Allow",
      "Sid": "ManageProgressBucket",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:Get*",
        "s3:PutBucket*",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucketPolicy",
        "s3:TagResource",
        "s3:UntagResource",
        "s3:ListTagsForResource",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::study-coach-progress-054776129200-eu-central-1-an"
    },
    {
      "Sid": "ReadBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:eu-central-1:054776129200:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "ReadRuntimeArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-054776129200-eu-central-1/e94d7a3b93bfc576bbd29399560670fc49a3535667b708d690b8fcb2e037735e.zip",
        "arn:aws:s3:::cdk-hnb659fds-assets-054776129200-eu-central-1/1cd44e4cb2cf89cee0c0476b88414b1510a8182745ec02122885c1018f56d04e.zip"
      ]
    },
    {
      "Sid": "ReadAssetsBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-054776129200-eu-central-1"
    },
    {
      "Sid": "DecryptRuntimeArtifactsViaS3",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-central-1:054776129200:key/ef7b98a8-af86-4168-aa62-5c26c26bc3a2",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.eu-central-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:aws:s3:arn": [
            "arn:aws:s3:::cdk-hnb659fds-assets-054776129200-eu-central-1",
            "arn:aws:s3:::cdk-hnb659fds-assets-054776129200-eu-central-1/*"
          ]
        }
      }
    },
    {
      "Sid": "DeleteStudyCoachRuntimeIdentity",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:DeleteWorkloadIdentity",
      "Resource": [
        "arn:aws:bedrock-agentcore:eu-central-1:054776129200:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:eu-central-1:054776129200:workload-identity-directory/default/workload-identity/AWSStudyCoach_default_agent-ftNEInBBU3"
      ]
    },
    {
      "Sid": "DeleteStudyCoachRuntimeEndpoint",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:DeleteAgentRuntimeEndpoint",
      "Resource": [
        "arn:aws:bedrock-agentcore:eu-central-1:054776129200:runtime/AWSStudyCoach_default_agent-ftNEInBBU3",
        "arn:aws:bedrock-agentcore:eu-central-1:054776129200:runtime/AWSStudyCoach_default_agent-ftNEInBBU3/runtime-endpoint/DEFAULT"
      ]
    }
  ]
}
